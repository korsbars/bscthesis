@inproceedings{kumarAarch64VsX86_642024,
  title = {Aarch64 vs. X86\_64 in {{HPC Cloud}}: {{Performance}} and {{Cost Evaluation}}},
  shorttitle = {Aarch64 vs. X86\_64 in {{HPC Cloud}}},
  booktitle = {2024 {{Eighth International Conference}} on {{Parallel}}, {{Distributed}} and {{Grid Computing}} ({{PDGC}})},
  author = {Kumar, Mandeep and Kaur, Gagandeep and Singh Rana, Prashant},
  date = {2024-12},
  pages = {85--88},
  issn = {2573-3079},
  doi = {10.1109/PDGC64653.2024.10983990},
  url = {https://ieeexplore.ieee.org/document/10983990},
  urldate = {2026-08-02},
  abstract = {The landscape of High Performance Computing (HPC) in cloud environments is rapidly evolving, and processor architecture plays a critical role in shaping its future. Traditionally, x86\_64 processors have dominated HPC clusters. However, the advent of the ARMv8-A architecture, specifically its 64-bit variant known as Aarch64, presents a significant challenge to this dominance. This study provides a comprehensive evaluation of Aarch64 versus x86\_64 in HPC cloud environments, focusing on scientific workloads. The analysis highlights the competitive edge of Aarch64, emphasizing its performance and cost efficiency compared to x86\_64. The findings demonstrate the potential advantages of Aarch64 in optimizing HPC cloud performance and managing costs effectively.},
  eventtitle = {2024 {{Eighth International Conference}} on {{Parallel}}, {{Distributed}} and {{Grid Computing}} ({{PDGC}})},
  keywords = {Aarch64,ARM,AWS Graviton,Computer architecture,Grid computing,High performance computing,HPC Cloud,Optimization,Performance evaluation,Program processors,Refining,Scalability,Scientific computing,Scientific Workloads,Software,x86_64}
}

